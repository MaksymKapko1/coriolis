# === Docker Postgres (docker-compose.yml) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=coriolis_db

# Только если запускаешь backend НА ХОСТЕ (не в Docker): localhost + порт 5435
# При docker compose up db_url подставляется автоматически (postgres:5432)
db_url=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5435/coriolis_db

# Fernet-ключ для шифрования linked signer keys в БД
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: смена ключа делает старые зашифрованные ключи в БД нечитаемыми
encryption_master_key=CHANGE_ME_FERNET_KEY

# Privy (https://dashboard.privy.io) — App Secret лучше перевыпустить после утечки
privy_app_id=your_privy_app_id
privy_app_secret=your_privy_app_secret

# CORS — добавь URL фронта (Vercel *.vercel.app или свой домен), через запятую
# cors_origins=http://localhost:5173,http://127.0.0.1:5173,https://coriolisxyz.xyz,https://www.coriolisxyz.xyz,https://coriolis-frontend-zeta.vercel.app

# Опционально
# db_echo=false
# nado_network=mainnet
